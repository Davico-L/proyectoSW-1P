# Puerto del servidor
PORT=4000
NODE_ENV=development

# Conexión a Postgres (Neon / Supabase / Local)
# Formato cadena de conexión completa (Recomendado para Neon o Supabase):
DATABASE_URL=postgresql://username:password@ep-your-database.region.aws.neon.tech/neondb?sslmode=require

# Variables individuales opcionales (si no se proporciona DATABASE_URL):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=proyectosw
PGSSL=false

# Proveedor de IA: "groq" (por defecto) o "gemini"
# AI_PROVIDER=groq

# Claves de las APIs de IA
# GEMINI_API_KEY=your-gemini-api-key
# GROQ_API_KEY=your-groq-api-key

# IA local (Colab / vLLM / llama.cpp - compatible OpenAI)
# Token secreto para el endpoint POST /ai/providers/local/register
# AI_REGISTRATION_TOKEN=your-secret-registration-token
# Tiempo máximo de espera para el modelo local en ms (por defecto 45000)
# LOCAL_AI_TIMEOUT_MS=45000

# Conexión a MongoDB Atlas (CU18 - Chat de equipo)
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=


